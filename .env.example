# 앱(웹·Android·iOS) 번들에 들어가는 값. 비워 두면 브라우저 안에서 도는 데모 모드로 실행된다
# Supabase 대시보드 > Project Settings > API Keys 에서 복사. ANON_KEY 에는 Publishable key(sb_publishable_…) 또는 legacy anon 키만! secret·service_role 키는 절대 넣지 않는다
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Cloudflare Turnstile 사이트 키 (공개값). 넣으면 비회원 시작·이메일 로그인·비밀번호 재설정에 캡차가 뜬다.
# Supabase Auth > Attack Protection 에서 CAPTCHA(Turnstile 비밀 키)를 켜기 *전에* 이 값을 넣은 빌드를 먼저 배포한다
VITE_TURNSTILE_SITE_KEY=
# KLIPY GIF 앱 키 (공개값: KLIPY 규칙상 사용자 기기에서 직접 부른다). partner.klipy.com 에서 발급. 비워 두면 채팅 GIF 버튼이 숨는다
VITE_KLIPY_APP_KEY=
# 포트원 V2 (공개값: 상점 ID·채널 키). 멤버십 웹 결제. 비워 두면 결제 버튼 대신 "준비 중"
# 채널은 "결제수단:채널키" 를 쉼표로 (card·kakaopay·naverpay·tosspay). 포트원 콘솔 > 결제 연동 > 채널 관리
# 나이스정보통신 채널은 kakaopay·naverpay 에만 (card·tosspay 불가). docs/포트원_연동_가이드.md 2-1장
VITE_PORTONE_STORE_ID=
VITE_PORTONE_CHANNELS=

# ↓ 아래 값은 앱에 넣지 않는다. Supabase Edge Function 비밀값으로만 등록한다
#   supabase secrets set KOPIS_API_KEY=... RESEND_API_KEY=... MAIL_FROM=... MUSICBRAINZ_USER_AGENT=...
# KOPIS_API_KEY=   ← 로컬 수집(pnpm fetch:opendata)용으로는 이 .env 에 넣어도 된다. VITE_ 가 아니라 앱 번들에는 안 들어간다
# RESEND_API_KEY=
# MAIL_FROM="덕친소 <noreply@your-domain>"
# MUSICBRAINZ_USER_AGENT="Duckchinso/0.1 ( your-contact@example.com )"
# 멤버십 결제 (포트원 V2). 운영·테스트 키를 따로 쓰고, 운영 키는 운영 프로젝트에만
# PORTONE_API_SECRET=      ← 포트원 콘솔 > 결제 연동 > 연동 정보 > V2 API Secret
# PORTONE_STORE_ID=
# PORTONE_WEBHOOK_SECRET=  ← 같은 화면의 웹훅 시크릿 (웹훅 주소: <project>/functions/v1/pg-webhook)
# BILLING_ENC_KEY=         ← 빌링키 암호화 키 (openssl rand -base64 32). 개인정보 키(PII_ENC_KEY)와 다른 값
# PORTONE_ALLOW_TEST=true  ← 스테이징에서만. 테스트 채널 빌링키를 받아 준다
# 로그인 보안 (운영 배포 점검: docs/보안감사_보완_설계.md 2장)
# TURNSTILE_SECRET=        ← 운영 필수. 없으면 비밀번호 재설정·아이디 찾기가 막힌다(fail-closed)
# CAPTCHA_DISABLED=1       ← 로컬·테스트에서만. 운영에 넣으면 캡차가 꺼진다
# SITE_ORIGINS=https://duckchinso.com   ← 운영은 https 만. 로컬은 http://localhost:5173 추가

# ↓ 로컬 DB 백업(docker/backup)용. 앱·Edge Function 에 넣지 않는다
# 대시보드 > Connect > Session pooler 의 URI (직접 연결 db.*.supabase.co 는 IPv6 전용이라 Docker 에서 안 붙을 수 있다)
# SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# BACKUP_KEEP_DAYS=14
