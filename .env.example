# 앱(웹·Android·iOS) 번들에 들어가는 값. 비워 두면 브라우저 안에서 도는 데모 모드로 실행된다
# Supabase 대시보드 > Project Settings > API Keys 에서 복사. ANON_KEY 에는 Publishable key(sb_publishable_…) 또는 legacy anon 키만! secret·service_role 키는 절대 넣지 않는다
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ↓ 아래 값은 앱에 넣지 않는다. Supabase Edge Function 비밀값으로만 등록한다
#   supabase secrets set KOPIS_API_KEY=... RESEND_API_KEY=... MAIL_FROM=... MUSICBRAINZ_USER_AGENT=...
# KOPIS_API_KEY=   ← 로컬 수집(pnpm fetch:opendata)용으로는 이 .env 에 넣어도 된다. VITE_ 가 아니라 앱 번들에는 안 들어간다
# RESEND_API_KEY=
# MAIL_FROM="덕친소 <noreply@your-domain>"
# MUSICBRAINZ_USER_AGENT="Duckchinso/0.1 ( your-contact@example.com )"
