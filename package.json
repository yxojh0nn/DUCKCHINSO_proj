{
  "name": "duckchinso",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types src/lib/calendar.test.ts && node --experimental-strip-types src/lib/klipy.test.ts && node --experimental-strip-types supabase/functions/_shared/kopis.test.ts && node --experimental-strip-types supabase/functions/_shared/crypto.test.ts && node --experimental-strip-types scripts/openData.test.ts && node --experimental-strip-types scripts/judge.test.ts && node supabase/tests/schema.test.mjs",
    "test:db": "node supabase/tests/schema.test.mjs",
    "dump:kopis": "node --env-file-if-exists=.env --experimental-strip-types scripts/dump-kopis-candidates.ts",
    "fetch:opendata": "node --env-file-if-exists=.env --experimental-strip-types scripts/fetch-open-data.ts",
    "cap:sync": "pnpm build && cap sync"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/share": "^8.0.3",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.105.1",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@electric-sql/pglite": "^0.5.14",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
