{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "web-demo",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "exec",
        "vite",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174,
      "env": {
        "VITE_SUPABASE_URL": "",
        "VITE_SUPABASE_ANON_KEY": ""
      }
    },
    {
      "name": "web-demo-klipy",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "exec",
        "vite",
        "--port",
        "5175",
        "--strictPort"
      ],
      "port": 5175,
      "env": {
        "VITE_SUPABASE_URL": "",
        "VITE_SUPABASE_ANON_KEY": "",
        "VITE_KLIPY_APP_KEY": "test-key"
      }
    },
    {
      "name": "web-demo-node",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/vite/bin/vite.js",
        "--port",
        "5176",
        "--strictPort"
      ],
      "port": 5176,
      "env": {
        "VITE_SUPABASE_URL": "",
        "VITE_SUPABASE_ANON_KEY": ""
      }
    }
  ]
}